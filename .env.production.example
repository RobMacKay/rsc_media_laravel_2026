# =============================================================================
#  RSC Media — production environment
# =============================================================================
#  Copy this into Forge's environment editor and fill in every PASTE marker.
#  Anything already filled in is the value this application wants in production
#  and should be left alone unless you know why you are changing it.
#
#  When it is in, run this on the server. It checks the things that otherwise
#  fail silently — no worker, a mailer that swallows everything, a stopped
#  scheduler — and exits non-zero if any of them would bite:
#
#      php artisan app:preflight
# =============================================================================


# --- The application ---------------------------------------------------------

APP_NAME="RSC Media"
APP_ENV=production
APP_DEBUG=false

# Generate once, on the server: php artisan key:generate
# Never reuse the local one, and never rotate it casually — see PASSKEYS below.
APP_KEY=<<PASTE: generated by key:generate>>

# Must be https and must match how people actually reach the site. Signed links
# (the welcome email, password resets) cover the scheme and host, so a mismatch
# here makes every one of them 403 the moment somebody clicks it.
APP_URL=https://rscmedia.co.uk

# Timestamps are stored in UTC. This is only what they are shown in.
APP_DISPLAY_TIMEZONE=Europe/London

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB


# --- Database ----------------------------------------------------------------
#  Forge fills most of this in when it creates the site. Check it rather than
#  assuming: the suite runs on SQLite locally and MySQL is what production uses.

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<<PASTE: database name from Forge>>
DB_USERNAME=<<PASTE: database user from Forge>>
DB_PASSWORD=<<PASTE: database password from Forge>>


# --- Sessions, cache and the queue -------------------------------------------

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Must be a real store. `array` would make the scheduler look permanently
# stopped, because the mark it leaves every minute would never survive.
CACHE_STORE=database

# Everything this application emails is queued. See the note at the bottom.
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local


# --- Email -------------------------------------------------------------------
#  Two valid pairings, do not mix them:
#    MAIL_SCHEME=smtps + MAIL_PORT=465   implicit TLS, encrypted from the start
#    MAIL_SCHEME=smtp  + MAIL_PORT=587   STARTTLS, upgrades after connecting
#  Prefer 465 where the provider offers it. `smtps` on 587 hangs until timeout
#  rather than failing with anything readable.

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=<<PASTE: smtp host, e.g. smtp.provider.com>>
MAIL_PORT=465
MAIL_USERNAME=<<PASTE: smtp username>>
# Quote it if it contains # $ or a space. An unquoted # starts a comment and
# silently truncates the rest of the line.
MAIL_PASSWORD="<<PASTE: smtp password>>"

# Must be a domain the provider is authorised to send for, with SPF and DKIM
# set up. Otherwise mail sends and lands in spam, which is worse than failing.
MAIL_FROM_ADDRESS="hello@rscmedia.co.uk"
MAIL_FROM_NAME="${APP_NAME}"


# --- Bot protection ----------------------------------------------------------
#  From the Cloudflare dashboard: Turnstile → Add widget, type **Managed**,
#  hostname rscmedia.co.uk. Both keys or neither — with one missing the
#  protection is off, and the public forms are unguarded.

TURNSTILE_SITE_KEY=<<PASTE: Turnstile site key>>
TURNSTILE_SECRET_KEY=<<PASTE: Turnstile secret key>>


# --- Passkeys ----------------------------------------------------------------
#  This falls back to APP_KEY when unset, which quietly ties every registered
#  passkey to it. Set it explicitly so rotating APP_KEY does not lock people
#  out of their own devices. Any long random string; generate one with:
#      php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'

PASSKEYS_USER_HANDLE_SECRET=<<PASTE: 64 random hex characters>>


# --- Logging -----------------------------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14


# =============================================================================
#  Three things that are NOT in this file, and will stop mail dead without it
# =============================================================================
#
#  1. A QUEUE WORKER. Every notification this application sends is queued, so
#     with no worker running, jobs pile up in the `jobs` table and nothing
#     errors anywhere — no confirmation links, no ticket alerts, no enquiry
#     alerts, no invoice chases, no site-down warnings. Forge → Queue, or:
#
#         php artisan queue:work --tries=3
#
#  2. THE SCHEDULER. Site checks every fifteen minutes, invoice chases daily,
#     plan invoices monthly. Forge → Scheduler.
#
#  3. SSL, so APP_URL above is true.
#
#  `php artisan app:preflight` checks all three and tells you which is missing.
# =============================================================================
